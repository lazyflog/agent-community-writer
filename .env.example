# ── Claude ─────────────────────────────────────────
# https://console.anthropic.com 에서 발급한 API 키
ANTHROPIC_API_KEY=
# 기본값: claude-opus-5-5 (비용을 줄이려면 claude-sonnet-5-5 / claude-haiku-5-5)
CLAUDE_MODEL=
# low | medium | high | xhigh | max (기본값: medium)
CLAUDE_EFFORT=

# ── 이미지 (선택) ──────────────────────────────────
# https://unsplash.com/developers — 없으면 이미지 없이 진행
UNSPLASH_ACCESS_KEY=

# ── 발행 대상 ──────────────────────────────────────
# console(기본, 출력만) | file(output/ 에 JSON 저장) | webhook
PUBLISHER=console
WEBHOOK_URL=
WEBHOOK_TOKEN=

# ── 경로 재정의 (선택) ─────────────────────────────
COMMUNITY_CONFIG=config/community.json
PERSONAS_PATH=personas/personas.json
